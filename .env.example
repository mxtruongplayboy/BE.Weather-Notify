# Firebase service account JSON (from Firebase Console → Project settings → Service accounts)
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-service-account.json

# Internal BE URLs (Docker network)
FORECAST_BE_URL=http://omfc-api:8080/v1
TRACKING_BE_URL=http://weather_tracking:8002/api/v1

# Scheduler
ALERT_CHECK_INTERVAL_S=900     # 15 minutes

# HTTP timeout for calls to other BEs (seconds)
HTTP_TIMEOUT_S=10.0

# Dedup TTLs (hours)
REALTIME_DEDUP_TTL_H=3
SUMMARY_DEDUP_TTL_H=23

# Alert trigger thresholds
LIGHTNING_RADIUS_KM=50.0
LIGHTNING_WINDOW_MINUTES=30
STORM_RADIUS_KM=500.0

LOG_LEVEL=INFO
